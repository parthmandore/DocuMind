# DocuMind AI Provider Configuration
# Set AI_PROVIDER to 'ollama' (100% offline local inference) or 'groq' (cloud generation)
AI_PROVIDER=groq

# Groq Cloud Inference (Optional Temporary Cloud Provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=120.0

# Local Ollama Inference (Permanent Local AI Engine)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_GENERATION_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BATCH_SIZE=8
LLM_NUM_PREDICT=2400

# Security & CORS Settings (Optional)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
ENABLE_HSTS=false

# Support & Feedback Email (Optional SMTP - Falls back to local logging if unconfigured)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
# SMTP_SENDER=noreply@documind.local
# SUPPORT_EMAIL_RECIPIENT=support@documind.local
