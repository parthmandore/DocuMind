# ==============================================================================
# DocuMind Root .gitignore
# Production-ready exclusion rules for Python, Node/Vite, SQLite, OS, & Secrets
# ==============================================================================

# --- Python Environments & Caches ---
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Python Testing & Quality Tooling ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# --- Node / Frontend Caches & Artifacts ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment & Secret Protection (CRITICAL) ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
*.p12

# --- Application Runtime Data & Local Persistence ---
*.db
*.db-wal
*.db-shm
data/ai_settings.json
data/support_messages.log
data/uploads/*
!data/uploads/.gitkeep
results/*.json
scratch/

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- IDE & Editor Artifacts ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# --- Logs & Diagnostics ---
*.log
logs/
